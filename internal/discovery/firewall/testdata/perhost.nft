add table inet jaco
delete table inet jaco
table inet jaco {
    set dep_net_nvf6upziwspxeyjrjmfnzdeykofevgroy555wzpj2x5qdvwdacnq {
        type ipv4_addr
        flags interval
        elements = { 10.244.7.0/24 }
    }

    set dep_net_6pdw7okxi4r6k2fehldyl3sjf5o5c4tfez5g6rmxk2z6oabuq7aq {
        type ipv4_addr
        flags interval
        elements = { 10.244.5.0/24, 10.244.6.0/24 }
    }

    set jaco_pool {
        type ipv4_addr
        flags interval
        elements = { 10.244.5.0/24, 10.244.6.0/24, 10.244.7.0/24 }
    }

    chain forward {
        type filter hook forward priority 0; policy accept;
        ip saddr @dep_net_nvf6upziwspxeyjrjmfnzdeykofevgroy555wzpj2x5qdvwdacnq ip daddr @dep_net_nvf6upziwspxeyjrjmfnzdeykofevgroy555wzpj2x5qdvwdacnq accept
        ip saddr @dep_net_6pdw7okxi4r6k2fehldyl3sjf5o5c4tfez5g6rmxk2z6oabuq7aq ip daddr @dep_net_6pdw7okxi4r6k2fehldyl3sjf5o5c4tfez5g6rmxk2z6oabuq7aq accept
        ip saddr @jaco_pool ip daddr @jaco_pool drop
    }

    chain input {
        type filter hook input priority 0; policy accept;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
